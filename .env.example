# Copy this file to .env and fill in ONE key (Gemini is the easiest free option).
#   cp .env.example .env
#
# Option 1 -- Google Gemini (FREE tier, recommended)
# Get a key in ~2 minutes at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 2 -- Groq (also has a free tier)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Option 3 -- OpenAI
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
